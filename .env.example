# AI工具API配置
# 复制此文件为 .env 并填入真实值

# ==================== 即梦AI (火山引擎) ====================
# 获取方式: https://console.volcengine.com/iam/keymanagement/
JIMENG_ACCESS_KEY=your_jimeng_access_key_here
JIMENG_SECRET_KEY=your_jimeng_secret_key_here

# ==================== DMXAPI (海螺/可灵等) ====================
# 获取方式: https://www.dmxapi.cn/
DMXAPI_TOKEN=your_dmxapi_token_here

# ==================== 可选: 其他API ====================
# Runway API (如需要)
# RUNWAY_API_KEY=your_runway_api_key_here

# 可灵官方API (如需要)
# KLING_API_KEY=your_kling_api_key_here
